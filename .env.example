# Contact form email delivery (Resend — https://resend.com)
# Without all three set, /api/contact returns 503 and the form tells the
# patient to call the clinic instead of silently dropping the enquiry.
#
# Where these live:
#   Local testing       → .dev.vars, then `npm run preview` (Cloudflare runtime, same format)
#   Cloudflare (live)   → npm run cf -- secret put RESEND_API_KEY   (repeat per var)
#                         or dashboard: Workers & Pages → imc-gungahlin → Settings → Variables and Secrets
#
# Do NOT put real secrets in .env / .env.local / .env.production(.local):
# the OpenNext build copies those values into the deployed Worker bundle.
# The same applies to CLOUDFLARE_API_TOKEN — see scripts/with-cf-token.sh.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain verified in your Resend account.
CONTACT_FROM_EMAIL=website@infinitymedicalcentre.com.au

# Where enquiries are delivered — the clinic's monitored inbox.
CONTACT_TO_EMAIL=
