# Contact form email delivery (Resend — https://resend.com)
# Without all three set, /api/contact returns 503 and the form tells the
# patient to call the clinic instead of silently dropping the enquiry.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain verified in your Resend account.
CONTACT_FROM_EMAIL=website@infinitymedicalcentre.com.au

# Where enquiries are delivered — the clinic's monitored inbox.
CONTACT_TO_EMAIL=
